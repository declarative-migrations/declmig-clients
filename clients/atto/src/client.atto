// Candidate AttoLang client boundary. This is a library, not an HTTP transport.
// Contract authority: declmig-interfaces; never use these helpers to approve parity.
define class Health as
    pub bool ok: false
    pub string service: ""
end

// The payload is JSON-owned by the admitted contract; this is only its header.
define class MigrationPlanHeader as
    pub string id: ""
    pub string revision: ""
end

pub fnc response_size_allowed(int body_bytes): bool {
    if body_bytes < 0 then
        return false;
    fi
    return body_bytes <= 65536;
}

pub fnc bearer_token_allowed(int token_bytes): bool {
    return token_bytes > 0;
}

pub fnc health_http_status_allowed(int status): bool {
    return status == 200;
}

pub fnc resource_id_lengths_allowed(int id_bytes, int revision_bytes): bool {
    if id_bytes <= 0 then
        return false;
    fi
    return revision_bytes > 0;
}
